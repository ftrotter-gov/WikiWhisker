# WikiWhisker — environment variables
#
# Copy this file to .env and fill in your API key(s).
# .env is gitignored and should never be committed.
#
# Only one key is needed — set the one that matches the --model you will use.

# OpenAI (default) — used for gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.
OPENAI_API_KEY=sk-...

# Anthropic — used for claude-3-5-sonnet-20241022, claude-3-haiku, etc.
# ANTHROPIC_API_KEY=sk-ant-...

# Local models via Ollama require no API key — just run `ollama serve` locally
# and pass --model ollama/llama3 (or similar) on the command line.
